// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`publishes orchestrator close-epic help 1`] = `
"Usage: pc workflow orchestrator close-epic [options] <number>

Record explicit human confirmation, close and archive an accepted EPIC

Options:
  --repository <owner/name>    Target repository
  --human-confirmation <text>  Exact explicit human closure confirmation
  --config <file>              Authoritative Fleet configuration (default:
                               ".epic-config.json")
  -h, --help                   display help for command
"
`;

exports[`publishes orchestrator finalize-epic help 1`] = `
"Usage: pc workflow orchestrator finalize-epic [options] <number>

Assess EPIC delivery; finalize specialists only after confirmed closure

Options:
  --repository <owner/name>  Target repository
  --retry                    Start a fresh finalization round only after
                             verified specialist termination
  --config <file>            Authoritative Fleet configuration (default:
                             ".epic-config.json")
  -h, --help                 display help for command
"
`;

exports[`publishes orchestrator group help 1`] = `
"Usage: pc workflow orchestrator [options] [command]

Create or inspect a subject-scoped managed Run

Options:
  -h, --help                        display help for command

Commands:
  status [options]                  Read concise current Runs, pending work and
                                    resource ownership
  start [options] <issue>           Create or reconnect a Run; report concise
                                    startup state
  recover [options] <run>           Recover late startup evidence without
                                    relaunch; preserve unknown occupancy
  recover-all [options]             Reconcile each incomplete Run; report
                                    unowned work as blocked
  finalize-epic [options] <number>  Assess EPIC delivery; finalize specialists
                                    only after confirmed closure
  close-epic [options] <number>     Record explicit human confirmation, close
                                    and archive an accepted EPIC
  land [options] <issue>            Merge, record, preserve and clean delivered
                                    PR stages automatically
  help [command]                    display help for command
"
`;

exports[`publishes orchestrator land help 1`] = `
"Usage: pc workflow orchestrator land [options] <issue>

Merge, record, preserve and clean delivered PR stages automatically

Options:
  --config <file>             Authoritative Fleet configuration (default:
                              ".epic-config.json")
  --confirmation-file <file>  EPIC professional confirmation JSON: epic, head,
                              evidence
  -h, --help                  display help for command
"
`;

exports[`publishes orchestrator recover help 1`] = `
"Usage: pc workflow orchestrator recover [options] <run>

Recover late startup evidence without relaunch; preserve unknown occupancy

Options:
  --replace        Replace Orchestrator only after verified termination
  --config <file>  Authoritative Fleet configuration (default:
                   ".epic-config.json")
  -h, --help       display help for command
"
`;

exports[`publishes orchestrator recover-all help 1`] = `
"Usage: pc workflow orchestrator recover-all [options]

Reconcile each incomplete Run; report unowned work as blocked

Options:
  --config <file>  Authoritative Fleet configuration (default:
                   ".epic-config.json")
  -h, --help       display help for command
"
`;

exports[`publishes orchestrator start help 1`] = `
"Usage: pc workflow orchestrator start [options] <issue>

Create or reconnect a Run; report concise startup state

Options:
  --detailed                  Return the complete current structured result;
                              logs remain referenced
  --provider <provider>       Managed provider: codex, agy, or claude
  --requirements <text>       Immutable additional Run Requirements
  --requirements-file <file>  Read immutable Run Requirements from a UTF-8 file
  --type <type>               Subject type; must match the title EPIC marker
                              (choices: "issue", "epic")
  --config <file>             Authoritative Fleet configuration (default:
                              ".epic-config.json")
  -h, --help                  display help for command
"
`;

exports[`publishes orchestrator status help 1`] = `
"Usage: pc workflow orchestrator status [options]

Read concise current Runs, pending work and resource ownership

Options:
  --detailed       Return the complete current structured result; logs remain
                   referenced
  --config <file>  Authoritative Fleet configuration (default:
                   ".epic-config.json")
  -h, --help       display help for command
"
`;
